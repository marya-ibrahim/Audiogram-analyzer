{
  "expo": {
    "name": "Audiogram Analyzer",
    "slug": "audiogram-analyzer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E1A"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Needed for headphone detection and audio output testing"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0A0E1A"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.maryaibrahim.audiogramanalyzer"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-audio", "expo-secure-store", "expo-sqlite", "expo-font"],
    "extra": {
      "eas": {
        "projectId": "0c8890b8-34b7-471e-8334-3010440326de"
      }
    }
  }
}
