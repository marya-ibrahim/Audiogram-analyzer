# ============================================================
# ENVIRONMENT VARIABLES
# Copy this file and rename to .env.local for your local setup
# NEVER commit .env.local to git
# ============================================================

# Your backend base URL — change this to your real server
API_BASE_URL=https://your-backend.com/api/v1

# Request timeout in milliseconds
API_TIMEOUT=10000

# App mode: "offline" uses SQLite only, "online" uses API, "hybrid" uses both
APP_MODE=hybrid

# JWT token key name in SecureStore
AUTH_TOKEN_KEY=audiogram_auth_token
